# ---------------------------------------------------------------------------
# Secrets and device-specific files
# ---------------------------------------------------------------------------
# Device-specific SPIFFS files remain local. Their root-level example templates
# are tracked as safe starting points.
data/config.json
# Legacy pre-JSON configuration files, ignored defensively if they reappear locally.
data/config.ini
data/display-catalog.json

# Never commit credentials, keys, or local overrides under any name.
*.pem
*.key
*.p12
secrets.*
*secrets.ini
config.local.ini
data/*.local.*

# ---------------------------------------------------------------------------
# PlatformIO build output
# ---------------------------------------------------------------------------
.pio/
.pioenvs/
.piolibdeps/
.clang_complete
.gcc-flags.json
compile_commands.json

# Vendor firmware images restored per FLASH_FACTORY_FIRMWARE.md are downloaded,
# not authored here.
/factory_firmware/

# ---------------------------------------------------------------------------
# Editor and tooling state
# ---------------------------------------------------------------------------
# .vscode/extensions.json and .vscode/settings.json stay tracked; the rest is
# machine-generated by PlatformIO and the C/C++ extension.
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/tasks.json
.vscode/ipch/
.cache/
.ccls-cache/
.idea/

# ---------------------------------------------------------------------------
# SquareLine Studio churn
# ---------------------------------------------------------------------------
# The project source under Arduino/ui_project/ is tracked, but SquareLine
# regenerates these on every open, save, and export.
Arduino/ui_project/**/autosave/
Arduino/ui_project/**/backup/
Arduino/ui_project/**/cache/

# Arduino/libraries/UI/ is the single tracked LVGL export consumed by the
# build. These are duplicate export destinations written by SquareLine.
Arduino/ui_project/**/OUT/
Arduino/ui_project/file/Output/

# ---------------------------------------------------------------------------
# OS and editor scratch files
# ---------------------------------------------------------------------------
.DS_Store
._*
Thumbs.db
desktop.ini
*~
*.swp
*.swo
*.bak
*.orig
*.rej
*.log
